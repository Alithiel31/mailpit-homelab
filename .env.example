# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais commiter le .env (voir .gitignore).

# Adresse Tailscale de l'hôte (`tailscale ip -4`) : le SMTP (1025) et l'interface web (8025)
# ne sont publiés que sur cette adresse et sur localhost.
TAILSCALE_IP=100.x.y.z

# (Optionnel) Nombre maximal de mails conservés (les plus anciens sont purgés). Défaut : 500.
# MP_MAX_MESSAGES=500
